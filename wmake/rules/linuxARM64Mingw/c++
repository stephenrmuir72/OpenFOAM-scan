#------------------------------------------------------------------------------
# llvm-mingw for ARM64 Windows target
# NB: gnu++14 (not c++14) to ensure __STRICT_ANSI__ is not defined
#------------------------------------------------------------------------------
include $(GENERAL_RULES)/Gcc/c++

CC         := aarch64-w64-mingw32-clang++ -std=gnu++17 
c++ARCH    := -pthread               

WM_ARCH_STR = "$(WM_ARCH)"
CC_FLAGS += -DWM_ARCH=$(WM_ARCH_STR)

ifneq (,$(strip $(WM_COMPILE_OPTION)))
    sinclude $(DEFAULT_RULES)/c++$(WM_COMPILE_OPTION)
endif

c++FLAGS    = \
    $(c++ARCH) $(GFLAGS) $(c++WARN) $(c++OPT) $(c++DBUG) $(ptFLAGS) \
    $(FOAM_EXTRA_CXXFLAGS) $(LIB_HEADER_DIRS) \
    -nostdinc++ \
    -isystem /opt/llvm-mingw/aarch64-w64-mingw32/include/c++/v1 \
    -isystem /opt/llvm-mingw/aarch64-w64-mingw32/include \
    -isystem /opt/llvm-mingw/aarch64-w64-mingw32/sysroot/include

Ctoo        = $(WM_SCHEDULER) $(CC) $(c++FLAGS) -c $< -o $@
cctoo       = $(Ctoo)
cpptoo      = $(Ctoo)
cxxtoo      = $(Ctoo)

LINK_LIBS   = $(c++DBUG)

LINKLIBSO   = $(CC) $(c++FLAGS) -shared \
    -Wl,--output-def=$(LIB).def \
    -Wl,--out-implib=$(LIB).dll.a \
     \
    -Wl,--no-undefined \
    -Wl,--enable-auto-import \
    -Wl,--strip-all

LINKEXE     = $(CC) $(c++FLAGS) \
    -static-libgcc -static-libstdc++ \
    -Wl,--enable-auto-import \
    -Wl,--strip-all \
    -mconsole

#------------------------------------------------------------------------------