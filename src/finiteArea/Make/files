/* -------------------------------------------------------------------------
 * libfiniteArea is a thin specialisation of libfiniteVolume:
 *   - areaMesh   == volMesh,     faPatchField<T>  == fvPatchField<T>
 *   - edgeMesh   == surfaceMesh, faePatchField<T> == fvsPatchField<T>
 *   - faMatrix<T> == fvMatrix<T>
 * so area/edge fields ARE vol/surface fields and every FV boundary condition
 * works on them directly. Consequently there are NO FA patch-field, matrix,
 * mesh-mapper, subset, distributor or ensight translation units here - those
 * are all reused from libfiniteVolume. Only the genuinely FA-specific pieces
 * are compiled: the reduced-order faMesh builder, one plate-specific BC, and
 * the manifold differential operators / edge-interpolation schemes (which
 * carry the tangential projection that flat FV does not).
 * ------------------------------------------------------------------------- */

faMesh/faMeshesRegistry.C
faMesh/faMesh.C
faMesh/faMeshNew.C
faMesh/faMeshProcAddressing/faMeshProcAddressing.C
faMesh/faMeshTools/faMeshToolsChecks.C

/* FA-specific derived BCs. Most BCs reuse FV directly; these are the ones
   that either encode FA-specific numerics (fixedValueOutflow, ignore) or
   preserve a legacy FA dictionary type-name. edgeNormalFixedValue is a thin
   backward-compat alias over the FV surfaceNormalFixedValue (identical on the
   reduced-order mesh, since fvPatch::nf() == the legacy faPatch::edgeNormals()). */
fields/faPatchFields/derived/clampedPlate/clampedPlateFaPatchFields.C
fields/faPatchFields/derived/edgeNormalFixedValue/edgeNormalFixedValueFaPatchVectorField.C
fields/faPatchFields/derived/fixedValueOutflow/fixedValueOutflowFaPatchFields.C
fields/faPatchFields/derived/ignore/ignoreFaPatchFields.C

/* areaScalarField&c are typedefs of the FV vol fields (see areaFieldsFwd.H);
   only the field name/type-string lists are compiled here. edgeFields have no
   TU - edgeScalarField&c are aliases of the FV surface fields. */
fields/areaFields/areaFields.C

edgeInterpolation = interpolation/edgeInterpolation
$(edgeInterpolation)/edgeInterpolationScheme/edgeInterpolationSchemes.C

schemes = $(edgeInterpolation)/schemes
$(schemes)/linear/linearEdgeInterpolationMake.C
$(schemes)/upwind/upwindEdgeInterpolationMake.C
$(schemes)/linearUpwind/linearUpwindEdgeInterpolationMake.C
$(schemes)/Gamma/GammaEdgeInterpolationMake.C
$(schemes)/blended/blendedEdgeInterpolationMake.C
$(schemes)/skewCorrected/skewCorrectedEdgeInterpolationMake.C
/*
Deferred: leastSquaresEdgeInterpolation::interpolate() still relies on the
removed faMesh point-topology API (mesh.patch().meshPoints()/pointFaces()),
so it needs a proper port to the reduced-order fvMesh point addressing.
$(schemes)/leastSquares/leastSquaresEdgeInterpolationMake.C
*/

finiteArea/fa/fa.C

/* ddt/d2dt2 schemes are NOT reimplemented for finite-area. Being purely
   temporal they are identical to the finite-volume schemes on the reduced-
   order faMesh (areaMesh == volMesh, faMatrix == fvMatrix, S() == V()), so the
   fam::ddt/fac::ddt/fam::d2dt2/fac::d2dt2 operators forward to fvm::/fvc::.
   The fv::ddtScheme runtime table (Euler/backward/steadyState/CrankNicolson/
   ...) is reused directly via the faMesh's fvSchemes ddtSchemes entry. */

divSchemes = finiteArea/divSchemes
finiteArea/fam/vectorFamDiv.C
$(divSchemes)/faDivScheme/faDivSchemes.C
$(divSchemes)/gaussFaDivScheme/gaussFaDivSchemes.C

gradSchemes = finiteArea/gradSchemes
$(gradSchemes)/faGradScheme/faGradSchemes.C
$(gradSchemes)/gaussFaGrad/gaussFaGrads.C
$(gradSchemes)/leastSquaresFaGrad/leastSquaresFaVectors.C
$(gradSchemes)/leastSquaresFaGrad/leastSquaresFaGrads.C

limitedGradSchemes = $(gradSchemes)/limitedGradSchemes
$(limitedGradSchemes)/faceLimitedFaGrad/faceLimitedFaGrads.C
$(limitedGradSchemes)/edgeLimitedFaGrad/edgeLimitedFaGrads.C

lnGradSchemes = finiteArea/lnGradSchemes
$(lnGradSchemes)/lnGradScheme/lnGradSchemes.C
$(lnGradSchemes)/correctedLnGrad/correctedLnGrads.C
$(lnGradSchemes)/uncorrectedLnGrad/uncorrectedLnGrads.C
$(lnGradSchemes)/limitedLnGrad/limitedLnGrads.C
$(lnGradSchemes)/fourthLnGrad/fourthLnGrads.C

laplacianSchemes = finiteArea/laplacianSchemes
$(laplacianSchemes)/faLaplacianScheme/faLaplacianSchemes.C
$(laplacianSchemes)/gaussFaLaplacianScheme/gaussFaLaplacianSchemes.C

convectionSchemes = finiteArea/convectionSchemes
$(convectionSchemes)/faConvectionScheme/faConvectionSchemes.C
$(convectionSchemes)/gaussFaConvectionScheme/gaussFaConvectionSchemes.C


LIB = $(FOAM_LIBBIN)/libfiniteArea
