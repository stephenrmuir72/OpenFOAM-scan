FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      waveProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

inlet
{
    alpha           alpha.water;

    waveModel       streamFunctionFenton;

    nPaddle         1;

    // nModels, waveHeight, waveLength are requested.
    nModes         10;

    waveHeight      0.1517;

    waveLength      6.2832;

    // waterDepth is optional. Due to the accuracy of the setFields, the explicit waterDepth is suggested.

    waterDepth      0.4046;

    waveAngle       0.0;

    // wavePeriod and uMean could be calcualted if Bjs and Ejs are not provided.

    wavePeriod      3.017;

    uMean           2.0825;

    rampTime        6.034; // two periods

    activeAbsorption yes;

    Bj1s
    (
        8.6669014e-002
        2.4849799e-002
        7.7446850e-003
        2.3355420e-003
        6.4497731e-004
        1.5205114e-004
        2.5433769e-005
       -2.2045436e-007
       -2.8711504e-006
       -1.2287334e-006
    );

    Ej1s
    (
        5.6009609e-002
        3.1638171e-002
        1.5375952e-002
        7.1743178e-003
        3.3737077e-003
        1.6324880e-003
        8.2331980e-004
        4.4403497e-004
        2.7580059e-004
        2.2810557e-004
    );

}

outlet
{
    alpha           alpha.water;

    waveModel       shallowWaterAbsorption;

    nPaddle         1;
}


// ************************************************************************* //
