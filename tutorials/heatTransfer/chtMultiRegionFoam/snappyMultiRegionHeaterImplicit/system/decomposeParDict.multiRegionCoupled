FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

numberOfSubdomains  3;

// One welded decomposition for the implicitly coupled regions, so both
// cells of every coupled face stay on one processor. Passed to every
// region through decomposePar -decomposeParDict.
method          multiRegionCoupled;

multiRegionCoupledCoeffs
{
    method          scotch;
}


