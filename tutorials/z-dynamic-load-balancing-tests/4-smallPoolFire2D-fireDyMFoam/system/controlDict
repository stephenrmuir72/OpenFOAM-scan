FoamFile
{
    version         2.0;
    format          ascii;
    class           dictionary;
    object          controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

DebugSwitches
{
    fvMesh 2;
    dynamicFvMesh 2;
    fvGeometryScheme 2;
    polyTopoChange 2;
    cyclicAMIPolyPatch 2;
    AMIInterpolation 2;

    dynamicLoadBalancer 2;
    distributed 2;
    performanceMetric 2;
    cellNumber 2;
    cpuLoad 2;
}

libs
(
    dynamicLoadBalancing
);

application     fireDyMFoam;

startFrom       startTime;

startTime       0.0;

stopAt          endTime;

endTime         3.0;
endTime         0.3;

deltaT          0.001;

writeControl    adjustable;

writeInterval   0.1;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

graphFormat     raw;

runTimeModifiable yes;

adjustTimeStep  yes;

maxCo           0.5;


