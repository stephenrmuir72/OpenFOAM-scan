FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

DebugSwitches
{
    fvMesh 2;
    dynamicFvMesh 2;
    fvGeometryScheme 2;
    polyTopoChange 2;
    cyclicAMIPolyPatch 2;
    AMIInterpolation 2;

    dynamicLoadBalancer 2;
    distributed 2;
    performanceMetric 2;
    cellNumber 2;
    cpuLoad 2;
}

OptimisationSwitches
{
    localAMIComm 2;
}

libs
(
    dynamicLoadBalancing
);

application     pimpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         0.5;
endTime         0.0018;

deltaT          1e-5;

writeControl    runTime;

writeInterval   0.00016;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           2;

functions
{
    FOfieldMinMax
    {
        type            fieldMinMax;
        libs            (fieldFunctionObjects);
        fields          (U p T);
    }

    FOmagU
    {
        type            mag;
        libs            (fieldFunctionObjects);
        field           U;
        result          magU;
        writeControl    writeTime;
    }
}


