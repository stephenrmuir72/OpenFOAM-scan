runParallel -o postProcess -func processorField

runParallel -o foamToVTK \
    -fields 'processorID' \
    -no-finite-area -noFunctionObjects -no-lagrangian

# runParallel -o redistributePar -reconstruct -withZero

# runParallel -s final checkMesh -latestTime

touch case.foam

