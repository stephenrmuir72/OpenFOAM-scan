FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

actions
(
    // A conductor column over one quarter of the block, piercing the mid-plane
    {
        name    conductor;
        type    cellSet;
        action  new;
        source  boxToCell;
        box     (-1 -1 -1) (0.05 0.05 1);
    }
    {
        name    conductor;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        set     conductor;
    }

    // The mid-plane internal faces, to extrude into the baffle region
    {
        name    midPlaneFaces;
        type    faceSet;
        action  new;
        source  boxToFace;
        box     (-1 -1 0.0499) (1 1 0.0501);
    }
    {
        name    midPlane;
        type    faceZoneSet;
        action  new;
        source  setToFaceZone;
        faceSet midPlaneFaces;
    }
);


