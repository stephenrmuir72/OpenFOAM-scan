FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

pointSync   false;

patches
(
    {
        name            coupledBottom;
        patchInfo
        {
            type            mappedWall;
            inGroups        (wall);
            sampleMode      nearestPatchFace;
            sampleRegion    region0;
            samplePatch     coupledBottom;
            offsetMode      uniform;
            offset          (0 0 0);
        }
        constructFrom   set;
        set             coupledBottom;
    }
    {
        name            coupledTop;
        patchInfo
        {
            type            mappedWall;
            inGroups        (wall);
            sampleMode      nearestPatchFace;
            sampleRegion    region0;
            samplePatch     coupledTop;
            offsetMode      uniform;
            offset          (0 0 -0.005);
        }
        constructFrom   set;
        set             coupledTop;
    }
);


