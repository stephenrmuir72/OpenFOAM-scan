FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

actions
(
    // Baffle faces coincident with the conductor bottom interface
    {
        name    coupledBottom;
        type    faceSet;
        action  new;
        source  conformalFaceToFace;
        region  region0;
        set     coupledBottom;
    }

    // Baffle faces one thickness behind the conductor top interface
    {
        name    coupledTop;
        type    faceSet;
        action  new;
        source  conformalFaceToFace;
        region  region0;
        set     coupledTop;
        distance 0.005;
        flipDistance yes;
    }
);


