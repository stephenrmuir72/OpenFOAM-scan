FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

// A 90 degree sector, split into two angular blocks at 45 degrees
// The first block is the conductor, with a face plane at the mid-radius
// becoming the curved baffle

vertices
(
    (0.04 0 0)                   //  0  inner  0 deg
    (0.06 0 0)                   //  1  outer  0 deg
    (0.0424264 0.0424264 0)      //  2  outer 45 deg
    (0.0282843 0.0282843 0)      //  3  inner 45 deg
    (0 0.06 0)                   //  4  outer 90 deg
    (0 0.04 0)                   //  5  inner 90 deg
    (0.04 0 0.01)                //  6
    (0.06 0 0.01)                //  7
    (0.0424264 0.0424264 0.01)   //  8
    (0.0282843 0.0282843 0.01)   //  9
    (0 0.06 0.01)                // 10
    (0 0.04 0.01)                // 11
);

blocks
(
    hex (0 1 2 3 6 7 8 9)  conductor (10 20 1) simpleGrading (1 1 1)
    hex (3 2 4 5 9 8 10 11)           (10 20 1) simpleGrading (1 1 1)
);

edges
(
    arc  0  3 (0.0369552 0.0153073 0)
    arc  3  5 (0.0153073 0.0369552 0)
    arc  1  2 (0.0554328 0.0229610 0)
    arc  2  4 (0.0229610 0.0554328 0)
    arc  6  9 (0.0369552 0.0153073 0.01)
    arc  9 11 (0.0153073 0.0369552 0.01)
    arc  7  8 (0.0554328 0.0229610 0.01)
    arc  8 10 (0.0229610 0.0554328 0.01)
);

// block/face referencing
boundary
(
    walls
    {
        type            wall;
        faces
        (
            (0 0)  // inner cylinder, 0-45 deg
            (1 0)  // inner cylinder, 45-90 deg
            (0 1)  // outer cylinder, 0-45 deg
            (1 1)  // outer cylinder, 45-90 deg
            (0 2)  // 0 deg end
            (1 3)  // 90 deg end
            (0 4)  // front, 0-45 deg
            (1 4)  // front, 45-90 deg
            (0 5)  // back, 0-45 deg
            (1 5)  // back, 45-90 deg
        );
    }
);


