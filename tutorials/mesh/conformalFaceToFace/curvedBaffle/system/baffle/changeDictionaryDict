FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      changeDictionaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Extrude gives the outer shell patch a per-face offset
// createPatch cannot resize that list, so reset the patch to a uniform offset

boundary
{
    region0_to_baffle_midShell_top
    {
        offsetMode      uniform;
        offset          (0 0 0);
    }
}


