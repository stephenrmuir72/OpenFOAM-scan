FoamFile
{
    version         2.0;
    format          ascii;
    class           dictionary;
    object          controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     moveDynamicMesh;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         4;

deltaT          0.01;

writeControl    timeStep;

//writeInterval   5;

writeInterval   1;

writeFormat     binary;

writePrecision  6;

runTimeModifiable yes;

adjustTimeStep no;

maxCo 0.5;

maxDeltaT 0.25;

// ************************************************************************* //
