FoamFile
{
    version         2.0;
    format          ascii;
    class           dictionary;
    object          blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

// square with a hole in the middle - centred around point (0 0 0)
width   12.5;
depth   0.1;

holeX   2.5;
holeY   0.5;

// Divisions in x/y/z directions
nx   20; // 10;
ny   24; // 12;
nz   1;

nx_hole  8;
ny_hole  2;

vertices
(
    // Back
    (-$width -$width -$depth)
    (-$holeX -$width -$depth)
    (-$holeX -$holeY -$depth)
    (-$width -$holeY -$depth)

    ( $holeX -$width -$depth)
    ( $holeX -$holeY -$depth)

    ( $width -$width -$depth)
    ( $width -$holeY -$depth)

    ( $width  $holeY -$depth)
    ( $holeX  $holeY -$depth)

    ( $width  $width -$depth)
    ( $holeX  $width -$depth)

    (-$holeX  $holeY -$depth)
    (-$holeX  $width -$depth)

    (-$width  $holeY -$depth)
    (-$width  $width -$depth)

    // Front
    (-$width -$width  $depth)
    (-$holeX -$width  $depth)
    (-$holeX -$holeY  $depth)
    (-$width -$holeY  $depth)

    ( $holeX -$width  $depth)
    ( $holeX -$holeY  $depth)

    ( $width -$width  $depth)
    ( $width -$holeY  $depth)

    ( $width  $holeY  $depth)
    ( $holeX  $holeY  $depth)

    ( $width  $width  $depth)
    ( $holeX  $width  $depth)

    (-$holeX  $holeY  $depth)
    (-$holeX  $width  $depth)

    (-$width  $holeY  $depth)
    (-$width  $width  $depth)
);

blocks
(
    hex (0 1 2 3 16 17 18 19)     ($nx $ny $nz)      grading (1 1 1)
    hex (1 4 5 2 17 20 21 18)     ($nx_hole $ny $nz) grading (1 1 1)
    hex (4 6 7 5 20 22 23 21)     ($nx $ny $nz)      grading (1 1 1)
    hex (5 7 8 9 21 23 24 25)     ($nx $ny_hole $nz) grading (1 1 1)
    hex (9 8 10 11 25 24 26 27)   ($nx $ny $nz)      grading (1 1 1)
    hex (12 9 11 13 28 25 27 29)  ($nx_hole $ny $nz) grading (1 1 1)
    hex (14 12 13 15 30 28 29 31) ($nx $ny $nz)      grading (1 1 1)
    hex (3 2 12 14 19 18 28 30)   ($nx $ny_hole $nz) grading (1 1 1)
);

edges ( );

boundary
(
    block
    {
        type wall;
        faces
        (
            (1 3)
            (3 0)
            (5 2)
            (7 1)
        );
    }

    top
    {
        type patch;
        faces
        (
            (6 3)
            (5 3)
            (4 3)
        );
    }

    bottom
    {
        type wall;
        faces
        (
            (0 2)
            (1 2)
            (2 2)
        );
    }

    left
    {
        type wall;
        faces
        (
            (0 0)
            (7 0)
            (6 0)
        );
    }

    right
    {
        type wall;
        faces
        (
            (2 1)
            (3 1)
            (4 1)
        );
    }

    defaultFaces
    {
        type empty;
        faces
        (
            (0 4)
            (1 4)
            (2 4)
            (3 4)
            (4 4)
            (5 4)
            (6 4)
            (7 4)

            (0 5)
            (1 5)
            (2 5)
            (3 5)
            (4 5)
            (5 5)
            (6 5)
            (7 5)
        );
    }
);

mergePatchPairs
(
);


