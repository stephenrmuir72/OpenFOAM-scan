FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

numberOfSubdomains  4;

// The sub-method on its own, for comparison: it knows nothing about the
// coupled faces and splits them across ranks
method          hierarchical;

coeffs
{
    n               (2 2 1);
    order           xyz;
}


// ************************************************************************* //
