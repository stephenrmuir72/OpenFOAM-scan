#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------
# Validated finiteArea parallel pipeline (plan §12.D, gated by ../../Alltest-parallel):
#   makeFaMesh (serial) builds the standalone FA region; decomposePar is
#   FA2-aware and splits the FA fields; makeFaMesh -parallel persists the
#   per-rank reduced-order FA mesh the solver reads; then the parallel solve and
#   reconstruct. The ensight areaWrite FO now runs in parallel (FA area/edge
#   output goes through the stock surfaceWriter parallel merge; see plan
#   §12.B/§12.D B5), so it is exercised here without -noFunctionObjects.

restore0Dir

runApplication blockMesh

runApplication makeFaMesh

runApplication decomposePar -force

# Distinct log suffix: the serial makeFaMesh above already wrote log.makeFaMesh,
# and runParallel would otherwise skip (RunFunctions refuses to overwrite a log),
# leaving the per-rank finite-area/polyMesh unbuilt.
runParallel -s parallel makeFaMesh

runParallel $(getApplication)

runApplication reconstructPar -latestTime

#------------------------------------------------------------------------------
