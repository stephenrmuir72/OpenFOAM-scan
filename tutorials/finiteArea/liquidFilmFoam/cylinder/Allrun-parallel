#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------
# Validated finiteArea parallel pipeline (plan §12.D, gated by ../../Alltest-parallel):
#   the film is a collapse2DMesh 'film' fvMesh region; the solver demand-builds
#   the finite-area mesh from it (no makeFaMesh). Build + setFields serially,
#   decompose both the base and the film regions (the film region reuses the
#   top-level system/decomposeParDict), run the parallel solve, then reconstruct
#   the film region. -noFunctionObjects skips the ensight areaWrite FO.

restore0Dir

runApplication blockMesh

runApplication collapse2DMesh film

runApplication setFields -region film

runApplication decomposePar -force

runApplication -s film \
    decomposePar -region film -force -decomposeParDict system/decomposeParDict

runParallel $(getApplication) -noFunctionObjects

runApplication reconstructPar -region film -latestTime

#------------------------------------------------------------------------------
