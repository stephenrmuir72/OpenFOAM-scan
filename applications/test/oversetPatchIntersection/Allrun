#!/bin/sh
cd "${0%/*}" || exit 1
. "${WM_PROJECT_DIR:?}/bin/tools/RunFunctions" || exit 1
set -e

if [ -e work ]; then
    echo "Refusing to overwrite existing test work directory: work" >&2
    exit 1
fi

wmake
mkdir work
trap 'rm -r work' EXIT
mkdir -p work/system work/constant
cp system/blockMeshDict work/system/blockMeshDict
cp system/controlDict work/system/controlDict
cp system/fvSchemes work/system/fvSchemes
cp system/fvSolution work/system/fvSolution

if ! (
    cd work
    blockMesh > log.blockMesh 2>&1 &&
    oversetPatchIntersection > log.test 2>&1 &&
    grep -q '^Passed exact overset patch intersection checks$' log.test
); then
    echo "Overset patch intersection regression failed" >&2
    if [ -f work/log.test ]; then
        tail -n 80 work/log.test >&2
    elif [ -f work/log.blockMesh ]; then
        tail -n 80 work/log.blockMesh >&2
    fi
    exit 1
fi

grep '^Planar triangle index:' work/log.test
echo "Passed exact overset patch intersection checks"
