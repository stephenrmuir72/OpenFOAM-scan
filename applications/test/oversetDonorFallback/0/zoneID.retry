FoamFile
{
    version 2.0;
    format ascii;
    class volScalarField;
    object zoneID;
}

dimensions [0 0 0 0 0 0 0];
internalField uniform 0;
boundaryField
{
    overset
    {
        type overset;
        value uniform 0;
    }
    realWall
    {
        type zeroGradient;
    }
    sides
    {
        type empty;
    }
}
