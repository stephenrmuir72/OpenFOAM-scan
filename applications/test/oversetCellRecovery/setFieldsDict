FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}

defaultFieldValues
(
    volScalarFieldValue zoneID 123
    volScalarFieldValue cellTypes 0
);

regions
(
    cellToCell
    {
        set c0;
        fieldValues
        (
            volScalarFieldValue zoneID 0
        );
    }

    cellToCell
    {
        set c1;
        fieldValues
        (
            volScalarFieldValue zoneID 1
        );
    }

    cellToCell
    {
        set recoveryCell;
        fieldValues
        (
            volScalarFieldValue cellTypes 2
        );
    }

    cellToCell
    {
        set unrecoverableCell;
        fieldValues
        (
            volScalarFieldValue cellTypes 2
        );
    }
);
