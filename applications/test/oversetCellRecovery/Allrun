#!/bin/sh
cd "${0%/*}" || exit
. "${WM_PROJECT_DIR:?}/bin/tools/RunFunctions" || exit 1
set -e

sourceCase="${WM_PROJECT_DIR}/tutorials/incompressible/overPimpleDyMFoam/simpleRotor"
affineSourceCase="${WM_PROJECT_DIR}/tutorials/incompressible/overPimpleDyMFoam/twoSimpleRotors"

if [ ! -d "$sourceCase" ] || [ ! -d "$affineSourceCase" ]; then
    echo "Missing moving-overset source cases: $sourceCase or $affineSourceCase" >&2
    exit 1
fi

if [ -e work ]; then
    echo "Refusing to overwrite existing test work directory: work" >&2
    exit 1
fi

wmake "${WM_PROJECT_DIR}/applications/solvers/incompressible/pimpleFoam/overPimpleDyMFoam"

mkdir work
trap 'rm -r work' EXIT

prepareCase()
{
    caseDir="$1"
    cp -a "$sourceCase" "$caseDir"
    cp topoSetDict "$caseDir/system/topoSetDict"
    cp setFieldsDict "$caseDir/system/setFieldsDict"
    cp "$caseDir/0.orig/zoneID" "$caseDir/0.orig/cellTypes"
    sed -i 's/object      zoneID;/object      cellTypes;/' \
        "$caseDir/0.orig/cellTypes"
}

fieldValue()
{
    awk -v celli="$2" '
        $1 == "internalField" && $2 == "nonuniform" {
            while (getline > 0 && $0 !~ /^[[:space:]]*\(/) {}
            for (i = 0; i <= celli; ++i)
            {
                if (getline <= 0)
                {
                    exit 1
                }
            }
            gsub(/[[:space:]();]/, "", $0)
            print $0
            found = 1
            exit
        }
        END {
            if (!found)
            {
                exit 1
            }
        }
    ' "$1"
}

verifyRecoveryTransition()
{
    caseDir="$1"
    celli=$(
        sed -n \
            's/^[[:space:]]*[0-9][0-9]*[[:space:]]*(\([0-9][0-9]*\).*/\1/p' \
            "$caseDir/constant/polyMesh/sets/recoveryCell"
    )

    if [ -z "$celli" ]; then
        echo "No recoveryCell was selected in $caseDir" >&2
        return 1
    fi

    for timeDir in "$caseDir"/[0-9]*
    do
        oldField="$timeDir/allCellTypes_old"
        frontField="$timeDir/allCellTypes_front"
        if [ ! -f "$oldField" ] || [ ! -f "$frontField" ]; then
            continue
        fi

        oldType=$(fieldValue "$oldField" "$celli") || continue
        frontType=$(fieldValue "$frontField" "$celli") || continue
        if awk -v oldType="$oldType" -v frontType="$frontType" \
            'BEGIN { exit !(oldType == 1 && frontType == 0) }'
        then
            echo "Verified reactivation followed by CALCULATED state: cell $celli"
            return 0
        fi
    done

    echo "Did not observe recoveryCell $celli return to CALCULATED" >&2
    return 1
}

for method in trackingInverseDistance inverseDistance cellVolumeWeight
do
    caseDir="work/${method}"
    prepareCase "$caseDir"

    sed -i -E \
        "s/^([[:space:]]*method[[:space:]]+)[^;]+;/\\1${method};/" \
        "$caseDir/system/fvSchemes"
    sed -i -E \
        's/^[[:space:]]*endTime[[:space:]]+0\.1;/endTime         0.005;/' \
        "$caseDir/system/controlDict"
    sed -i -E \
        -e 's/^[[:space:]]*writeControl[[:space:]]+adjustable;/writeControl    timeStep;/' \
        -e 's/^[[:space:]]*writeInterval[[:space:]]+0\.01;/writeInterval   1;/' \
        "$caseDir/system/controlDict"
    sed -i '/^[[:space:]]*application[[:space:]]*overPimpleDyMFoam;/a\
DebugSwitches\
{\
    cellCellStencil 3;\
    inverseDistance 3;\
    trackingInverseDistance 3;\
    cellVolumeWeight 3;\
}' "$caseDir/system/controlDict"

    if [ "$method" = trackingInverseDistance ]; then
        sed -i -E \
            's/^[[:space:]]*searchBoxDivisions[[:space:]]+\(130 130 1\);/searchBoxDivisions  2{(64 64 1)};/' \
            "$caseDir/system/fvSchemes"
    fi

    if ! (
        cd "$caseDir"
        ./Allrun.pre > log.pre 2>&1 &&
        overPimpleDyMFoam > log.solver 2>&1 &&
        grep -q '^End$' log.solver &&
        grep -q 'Previously blanked-cell recovery:' log.solver &&
        grep -Eq \
            'Previously blanked-cell recovery:.*[1-9][0-9]* using same-zone fallback' \
            log.solver &&
        grep -Eq \
            'Unable to reconstruct [1-9][0-9]* previously blanked cells' \
            log.solver
    ); then
        echo "Moving-overset recovery test failed for $method" >&2
        if [ -f "$caseDir/log.solver" ]; then
            tail -n 80 "$caseDir/log.solver" >&2
        elif [ -f "$caseDir/log.pre" ]; then
            tail -n 80 "$caseDir/log.pre" >&2
        fi
        exit 1
    fi

    if [ "$method" = trackingInverseDistance ]; then
        if ! grep -q 'Constructed cell voxel meshes' "$caseDir/log.solver" \
            || ! grep -q 'Constructing voxel mesh' "$caseDir/log.solver"; then
            echo "Tracking voxel-mesh debug output was not generated" >&2
            tail -n 80 "$caseDir/log.solver" >&2
            exit 1
        fi
    fi

    if ! verifyRecoveryTransition "$caseDir"; then
        echo "Moving-overset reactivation-transition test failed for $method" >&2
        exit 1
    fi

    echo "Passed moving-overset recovery smoke test: $method"
    echo "Exercised donor initialization, same-zone fallback, and unrecoverable holes: $method"
done

if command -v mpirun >/dev/null 2>&1; then
    caseDir="work/trackingInverseDistance-parallel"
    prepareCase "$caseDir"
    sed -i -E \
        's/^([[:space:]]*method[[:space:]]+)[^;]+;/\1trackingInverseDistance;/' \
        "$caseDir/system/fvSchemes"
    sed -i -E \
        's/^[[:space:]]*searchBoxDivisions[[:space:]]+\(130 130 1\);/searchBoxDivisions  2{(64 64 1)};/' \
        "$caseDir/system/fvSchemes"
    sed -i -E \
        's/^[[:space:]]*endTime[[:space:]]+0\.1;/endTime         0.005;/' \
        "$caseDir/system/controlDict"
    sed -i '/^[[:space:]]*application[[:space:]]*overPimpleDyMFoam;/a\
DebugSwitches\
{\
    cellCellStencil 1;\
    trackingInverseDistance 1;\
}' "$caseDir/system/controlDict"

    if ! (
        cd "$caseDir"
        ./Allrun.pre > log.pre 2>&1 &&
        runApplication decomposePar -force &&
        runParallel overPimpleDyMFoam &&
        grep -q '^End$' log.overPimpleDyMFoam &&
        grep -q 'Previously blanked-cell recovery:' log.overPimpleDyMFoam &&
        grep -Eq \
            'Previously blanked-cell recovery:.*[1-9][0-9]* using same-zone fallback' \
            log.overPimpleDyMFoam &&
        grep -Eq \
            'Unable to reconstruct [1-9][0-9]* previously blanked cells' \
            log.overPimpleDyMFoam
    ); then
        echo "Parallel moving-overset recovery test failed" >&2
        if [ -f "$caseDir/log.overPimpleDyMFoam" ]; then
            tail -n 80 "$caseDir/log.overPimpleDyMFoam" >&2
        elif [ -f "$caseDir/log.decomposePar" ]; then
            tail -n 80 "$caseDir/log.decomposePar" >&2
        elif [ -f "$caseDir/log.pre" ]; then
            tail -n 80 "$caseDir/log.pre" >&2
        fi
        exit 1
    fi

    echo "Passed parallel moving-overset recovery smoke test: trackingInverseDistance"
    echo "Exercised donor initialization, same-zone fallback, and unrecoverable holes in parallel"
fi

prepareAffineCase()
{
    caseDir="$1"
    method="$2"
    cp -a "$affineSourceCase" "$caseDir"
    foamDictionary "$caseDir/system/fvSchemes" \
        -entry oversetInterpolation.method -set "$method" >/dev/null
    foamDictionary "$caseDir/system/fvSchemes" \
        -entry oversetInterpolation.weightingScheme -add linearExact >/dev/null
    if [ "$method" != trackingInverseDistance ]; then
        foamDictionary "$caseDir/system/fvSchemes" \
            -entry oversetInterpolation.searchBoxDivisions -set '(64 64 1)' >/dev/null
    fi
    foamDictionary "$caseDir/system/controlDict" \
        -entry startFrom -set startTime >/dev/null
    foamDictionary "$caseDir/system/controlDict" \
        -entry adjustTimeStep -set false >/dev/null
    foamDictionary "$caseDir/system/controlDict" \
        -entry deltaT -set 0.00008 >/dev/null
    foamDictionary "$caseDir/system/controlDict" \
        -entry endTime -set 0.0016 >/dev/null
    foamDictionary "$caseDir/system/controlDict" \
        -entry writeInterval -set 20 >/dev/null
}

checkMovingAffine()
{
    caseDir="$1"
    logFile="$2"
    grep -q '^End$' "$logFile" &&
    [ "$(grep -c '^Time =' "$logFile")" -eq 20 ] || return 1
    if grep -Eq 'nearest-donor (fallback|injection)|Invalid overset interpolation' "$logFile"; then
        echo "Moving affine case unexpectedly rejected a stencil: $caseDir" >&2
        return 1
    fi
    awk '
        $1 == "calculated" && $2 == ":" { calculated = $3 }
        $1 == "interpolated" && $2 == ":" { interpolated = $3 }
        $1 == "hole" && $2 == ":" {
            if (calculated + interpolated + $3 != 12008) { failed = 1 }
            print calculated, interpolated, $3
            ++updates
        }
        END { exit (failed || updates != 20) }
    ' "$logFile" > "$caseDir/partitionSignature" || return 1
    for field in p U
    do
        columns=4
        if [ "$field" = p ]; then
            columns=2
        fi
        probeFile="$caseDir/postProcessing/probes/0/$field"
        if [ ! -f "$probeFile" ]; then
            echo "Missing affine probe output: $probeFile" >&2
            return 1
        fi
        awk -v columns="$columns" '
            /^[[:space:]]*#/ { next }
            {
                gsub(/[()]/, "")
                if (NF != columns) { failed = 1 }
                for (i = 1; i <= NF; ++i) {
                    if ($i !~ /^[-+]?([0-9]+([.][0-9]*)?|[.][0-9]+)([eE][-+]?[0-9]+)?$/) {
                        failed = 1
                    }
                }
                ++samples
            }
            END { exit (failed || samples != 20) }
        ' "$probeFile" || return 1
    done
}

for method in trackingInverseDistance inverseDistance leastSquares
do
    caseDir="work/affine-${method}"
    prepareAffineCase "$caseDir" "$method"
    if ! (
        cd "$caseDir"
        ./Allrun.pre > log.pre 2>&1 &&
        overPimpleDyMFoam > log.solver 2>&1
    ) || ! checkMovingAffine "$caseDir" "$caseDir/log.solver"; then
        echo "Moving affine regression failed for $method" >&2
        tail -n 80 "$caseDir/log.pre" "$caseDir/log.solver" >&2
        exit 1
    fi
    cmp work/affine-trackingInverseDistance/partitionSignature \
        "$caseDir/partitionSignature"
    echo "Passed 20-update moving affine regression without fallback: $method"
done

if command -v mpirun >/dev/null 2>&1; then
    caseDir="work/affine-trackingInverseDistance-parallel"
    prepareAffineCase "$caseDir" trackingInverseDistance
    if ! (
        cd "$caseDir"
        ./Allrun.pre > log.pre 2>&1 &&
        runApplication decomposePar -force &&
        runParallel overPimpleDyMFoam
    ) || ! checkMovingAffine "$caseDir" "$caseDir/log.overPimpleDyMFoam"; then
        echo "Parallel moving affine regression failed" >&2
        tail -n 80 "$caseDir/log.pre" "$caseDir/log.overPimpleDyMFoam" >&2
        exit 1
    fi
    cmp work/affine-trackingInverseDistance/partitionSignature \
        "$caseDir/partitionSignature"
    echo "Passed parallel 20-update moving affine regression without fallback"
fi
