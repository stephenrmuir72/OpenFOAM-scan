FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object fvSolution;
}

solvers
{
    h
    {
        solver GAMG;
        smoother GaussSeidel;
        tolerance 1e-12;
        relTol 0;
        maxIter 100;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    residualControl
    {
        h 1e-12;
    }
}

relaxationFactors
{
    equations
    {
        h 1;
    }
}
