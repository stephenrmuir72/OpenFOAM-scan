FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Uniform Cartesian background: domain [-0.5, 0.5]^3, 16 cells per direction.
// The sphere of radius 0.25 is cut from this background.

scale 1;

vertices
(
    (-0.5 -0.5 -0.5)    // 0
    ( 0.5 -0.5 -0.5)    // 1
    ( 0.5  0.5 -0.5)    // 2
    (-0.5  0.5 -0.5)    // 3
    (-0.5 -0.5  0.5)    // 4
    ( 0.5 -0.5  0.5)    // 5
    ( 0.5  0.5  0.5)    // 6
    (-0.5  0.5  0.5)    // 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (16 16 16) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    outer
    {
        type patch;
        faces
        (
            (0 3 2 1)   // z-min
            (4 5 6 7)   // z-max
            (1 5 4 0)   // y-min
            (3 7 6 2)   // y-max
            (0 4 7 3)   // x-min
            (2 6 5 1)   // x-max
        );
    }
);

mergePatchPairs
(
);

